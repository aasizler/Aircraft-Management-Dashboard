# Copy to .env.local and fill in. .env.local is gitignored.
#
# URL + anon key are safe to be public (RLS enforces access) — these match the
# existing AeroTrack Supabase project and are already in the legacy HTML app.
NEXT_PUBLIC_SUPABASE_URL=https://ggqucvfsqdvlhrfmrrcw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zBwC81maEoni813DAMdYkA_djiX2Q3C

# Not here: the Anthropic key for meter OCR and receipt scanning. Those run as
# Supabase Edge Functions and read ANTHROPIC_API_KEY from Supabase's secrets
# (supabase secrets set ANTHROPIC_API_KEY=...), never from this app.

# ADS-B Exchange via RapidAPI (rapidapi.com → adsbexchange-com1). Optional:
# without it live positions come from adsb.lol, whose receiver coverage is
# thinner at low altitude. Server-side only — never NEXT_PUBLIC_.
ADSBX_RAPIDAPI_KEY=
